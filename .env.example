APP_NAME="Martori Farms"
APP_SLOGAN="American Grower of Fruits + Vegetables"
APP_ENV=local
APP_KEY=
DB_ENCRYPTION_KEY=
APP_DEBUG=true
APP_URL=https://martori.localhost
APP_SERVICE=checkin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true

#SAIL_XDEBUG_MODE=coverage

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Password for the demo account seeded by UserSeeder outside production.
# Defaults to "password" when unset.
SEED_ADMIN_PASSWORD=

# PDF rendering (Browsershot + headless Chrome).
# Chrome lives in ./.puppeteer via .puppeteerrc.cjs so every container shares
# one copy through the bind mount. Sandboxing is disabled by default in
# config/laravel-pdf.php because rendering always runs unprivileged in a
# container. These paths only need setting where auto-detection fails.
# LARAVEL_PDF_NODE_BINARY=/usr/bin/node
# LARAVEL_PDF_NODE_MODULES_PATH=/app/node_modules

# Short links for the URL sent by text. A GSM-7 segment is 160 characters, so
# the link is kept off the long account-history path. Unset follows APP_URL,
# which is what local development wants. In production this is the client's own
# domain; set SHORTLINK_PREFIX empty when that host serves nothing but links, so
# the code sits at the root:
#   SHORTLINK_HOST=go.dockin.app
#   SHORTLINK_PREFIX=
SHORTLINK_HOST=
SHORTLINK_PREFIX=r
SHORTLINK_SCHEME=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Horizon dashboard. Left unset locally, so the dashboard stays at /horizon on the
# app domain. Move it onto the tailnet and off the public FQDN:
#TS_AUTHKEY=
#HORIZON_DOMAIN=

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ALWAYS_TO=

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

CONTACT_PHONE="(800) 555-0100"
CONTACT_EMAIL="dispatch@martorifarms.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=true
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"

# Reverb (live staff dashboard). Generate the app credentials with
# `php artisan reverb:install`. Laravel publishes straight to the `reverb`
# container; the browser connects through Octane's Caddy, which proxies /app/*
# to it. The page is https, so the socket must be wss on the same host and port.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PROXY_UPSTREAM=reverb:8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=martori.localhost
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
